---
import { site } from "../data/site";
const { footer } = site;
---

<footer>
  <div class="container foot">
    <div class="foot-id">
      <img class="foot-logo" src="/logo-white.png" alt={site.name} width="2600" height="293" />
      <p class="foot-line">{footer.tagline}</p>
    </div>
    <nav class="foot-cols" aria-label="Footer">
      {footer.columns.map((col) => (
        <div class="foot-col">
          <p class="t-eyebrow">{col.title}</p>
          <ul>
            {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="container foot-bottom">
    <a class="foot-cyp" href="https://centreforyouthpolicy.org" target="_blank" rel="noopener">
      <span class="foot-cyp-label">A programme of</span>
      <img src="/img/cyp-white.png" alt="Centre for Youth Policy" width="2531" height="595" />
    </a>
    <p class="foot-fine">
      © {new Date().getFullYear()} {site.name}.
      {footer.designer && <span class="foot-designer"> {footer.designer}</span>}
    </p>
  </div>
</footer>

<style>
  /* Footer sits directly on the black canvas — everything flips to paper. */
  footer { color: var(--paper); border-top: 2px solid rgba(255, 255, 255, 0.22); padding-block: 3.4rem 2.4rem; margin-top: var(--gap-stack); }

  .foot {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 2.5rem 3.5rem; flex-wrap: wrap;
    padding-bottom: 2.4rem; border-bottom: 2px solid rgba(255, 255, 255, 0.22);
  }
  .foot-id { max-width: 32rem; }
  .foot-logo { width: clamp(210px, 30vw, 300px); height: auto; }
  .foot-line { color: rgba(255, 255, 255, 0.72); font-size: 0.95rem; line-height: 1.5; margin-top: 1.1rem; max-width: 36ch; }

  .foot-cols { display: flex; gap: 3.5rem; flex-wrap: wrap; }
  .foot-col .t-eyebrow { color: var(--acid-lime); }
  .foot-col ul { list-style: none; margin-top: 0.9rem; display: flex; flex-direction: column; gap: 0.55rem; }
  .foot-col a { color: rgba(255, 255, 255, 0.72); font-size: 0.92rem; transition: color 0.2s var(--ease); }
  .foot-col a:hover { color: var(--paper); }

  .foot-bottom {
    margin-top: 2.2rem; display: flex; align-items: center; justify-content: space-between;
    gap: 1.4rem 2rem; flex-wrap: wrap;
  }
  .foot-cyp { display: flex; flex-direction: column; gap: 0.5rem; }
  .foot-cyp-label { color: rgba(255, 255, 255, 0.6); font-weight: 800; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; }
  .foot-cyp img { height: 34px; width: auto; }
  .foot-fine { color: rgba(255, 255, 255, 0.55); font-size: 0.75rem; letter-spacing: 0.03em; }
  .foot-designer { color: var(--acid-lime); font-weight: 700; }

  @media (max-width: 640px) { .foot-bottom { flex-direction: column; align-items: flex-start; } }
</style>
